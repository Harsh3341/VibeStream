# Copy to .env and fill in. Used by docker-compose.app.yml (compose auto-loads .env).
# NEVER commit the filled-in .env — only this example is tracked.

# From the Spotify developer dashboard (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered on the Spotify app, byte-for-byte.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5062/api/v1/auth/spotify/callback

# At least 32 characters (HMAC-SHA256). Generate one, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=

# Where the browser reaches the SPA and the API.
FRONTEND_BASE_URL=http://127.0.0.1:3000
PUBLIC_API_BASE_URL=http://127.0.0.1:5062
