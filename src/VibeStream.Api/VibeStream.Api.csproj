<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The OpenAPI generator reads /// summaries from this file, so Scalar shows real descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = "missing XML comment for public member". GenerateDocumentationFile turns it on for
         every public member; suppressed so it doesn't bury the warnings that matter. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>b89f094c-2367-4671-a15b-84c932caaf0c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- First-party OpenAPI document generation (replaced Swashbuckle in the .NET 9 templates). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- The UI that renders that document, at /scalar/v1. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
    <!-- JWT bearer authentication. Also transitively provides System.IdentityModel.Tokens.Jwt +
         Microsoft.IdentityModel.Tokens, which the token issuer uses to mint tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeStream.Application\VibeStream.Application.csproj" />
    <ProjectReference Include="..\VibeStream.Infrastructure\VibeStream.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: required by the `dotnet ef` tools, which boot THIS project (the startup
           project) to discover the DbContext. PrivateAssets keeps it out of the published output —
           it's a build/tooling dependency, never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
