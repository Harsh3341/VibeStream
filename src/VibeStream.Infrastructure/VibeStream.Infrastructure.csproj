<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeStream.Application\VibeStream.Application.csproj" />
  </ItemGroup>

  <!--
    Versions are PINNED EXACTLY. A floating range means two machines can build different binaries
    from the same commit; pinning makes the dependency graph part of the commit. Bump deliberately,
    then run the tests.
  -->
  <ItemGroup>
    <!-- Pin EF Core itself so every consumer unifies on this version. Without it, the Npgsql provider
         drags in a lower EF Core (10.0.4) transitively while the Design package (API-only, PrivateAssets)
         pulls 10.0.12 — the Worker then sees 10.0.4 and fails with CS1705 against this assembly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />

    <!-- EF Core provider for PostgreSQL. 10.0.x tracks EF Core 10. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Design-time only: the `dotnet ef migrations` tooling. PrivateAssets keeps it out of the
         published output and from leaking to referencing projects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Redis client for the cache layer (and the readiness ping). -->
    <PackageReference Include="StackExchange.Redis" Version="3.3.0" />

    <!-- Health-check primitives. Host-agnostic (Microsoft.Extensions.*, not ASP.NET), so the
         checks and their registration can live here in Infrastructure; only the HTTP endpoint
         mapping stays in the API. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />

    <!-- IConfiguration + GetConnectionString for the DI extension. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />

    <!-- Maps PascalCase entities/properties to snake_case tables/columns at model-build time.
           Tracks EF Core's major version (10.0.x → EF Core 10). -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- The Options pattern: OptionsBuilder.Bind comes from this package; Validate/ValidateOnStart
         come from the Microsoft.Extensions.Options it pulls in. Lets SpotifyOptions bind from config
         and fail loudly at startup when a required credential is missing. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />

    <!-- AddHttpClient + the typed-client factory (IHttpClientFactory). Host-agnostic, so the Spotify
         clients register here in Infrastructure and work identically in the API and the Worker. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
